@startuml
title 智能笔记助手需求分析｜核心业务类图 v0.2（定稿）

hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam linetype ortho
skinparam packageStyle rectangle

package "资源管理簇" {
class 用户 {
  user_id
  角色
  显示名
  状态
}

class 工作区 {
  workspace_id
  名称
  范围说明
}

class 文档空间 {
  space_id
  名称
  授权范围
}

class 文档 {
  document_id
  标题
  格式
  敏感级别
  授权状态
}

class 文档版本 {
  version_id
  导入时间
  来源哈希
  是否失效
}

class 内容块 {
  block_id
  类型
  文本片段
  章节路径
  置信度
}
}

package "导入与索引簇" {
class 解析任务 {
  task_id
  状态
  警告信息
}

class 索引任务 {
  run_id
  状态
  引擎版本
}

class 索引 {
  index_id
  索引类型
  建立状态
  是否失效
}
}

package "检索与回答簇" {
class 检索请求 {
  query_id
  请求文本
  请求类型
  创建时间
}

class 文档集合 {
  set_id
  选择范围
}

class 证据 {
  evidence_id
  定位状态
  契约状态
}

class 回答结果 {
  answer_id
  状态
  是否待复核
  生成时间
}

class 引用 {
  citation_id
  页码_章节
  定位符
  引用文本
}

class 笔记 {
  note_id
  类型
  正文
  标签
  创建时间
}
}

package "笔记与标注簇" {
class 笔记模板 {
  template_id
  类型
  字段定义
  输出格式
}

class 批注 {
  annotation_id
  锚定位置
  批注文本
  创建时间
}

class 标签 {
  tag_id
  名称
}

class 分享链接 {
  share_id
  范围
  有效期
  访问权限
}
}

package "规则与治理簇" {
class 权限规则 {
  rule_id
  主体
  资源
  动作
  规则版本
}

class 策略 {
  policy_id
  版本
  引用要求
  审核门槛
}
}

' 资源管理主线
用户 "0..*" -- "1..*" 工作区 : 成员
工作区 "1" o-- "0..*" 文档空间 : 管理
文档空间 "1" o-- "0..*" 文档 : 收纳
文档 "1" *-- "1..*" 文档版本 : 版本化
文档版本 "1" *-- "0..*" 内容块 : 切分为

' 导入与索引主线
文档版本 "1" --> "0..*" 解析任务 : 触发解析
解析任务 ..> 内容块 : 生成
文档版本 "1" --> "0..*" 索引任务 : 触发索引
索引任务 "1" --> "0..1" 索引 : 生成

' 检索与回答主线
用户 "1" --> "0..*" 检索请求 : 发起
检索请求 "0..*" --> "0..1" 文档集合 : 作用于
文档集合 "1" --> "1..*" 文档版本 : 选定
检索请求 ..> 索引 : 基于
检索请求 "1" --> "0..*" 证据 : 选取
检索请求 "1" --> "0..1" 回答结果 : 生成
证据 "1" --> "1" 内容块 : 定位到
回答结果 "1" o-- "0..*" 引用 : 绑定
引用 "1" --> "1" 证据 : 指向
用户 "1" --> "0..*" 笔记 : 创建
笔记 "0..*" --> "0..1" 内容块 : 锚定原文
笔记 "0..*" --> "0..1" 回答结果 : 记录结论

' 笔记与标注主线
笔记 "0..1" --> "0..1" 笔记模板 : 依据
笔记 "1" o-- "0..*" 批注 : 附带
笔记 "0..*" --> "0..*" 标签 : 打标
笔记 "0..*" --> "0..*" 分享链接 : 生成
用户 "1" --> "0..*" 笔记模板 : 维护

' 规则与治理
工作区 "1" o-- "0..*" 策略 : 采用
权限规则 ..> 文档 : 约束访问
权限规则 ..> 分享链接 : 约束范围
权限规则 ..> 检索请求 : 约束范围
分享链接 ..> 策略 : 依据
回答结果 ..> 策略 : 遵循

legend right
  本图定位：
  1. 需求分析阶段核心业务类图 v0.2（定稿）
  2. 覆盖文档导入与索引、笔记保存与导出、检索请求处理三条关键流程
  3. 暂不展开数据库表、接口字段、部署组件

  v0.2 相对 v0.1 的变化：
  - 纳入「解析任务」「索引任务」，与《文档导入与索引时序图》对齐
  - 新增「导入与索引簇」，「索引」改由该簇承载

  本轮刻意不纳入主图的对象：
  - 通知（跨流程边界对象，仅在三张时序图中出现）
  - 审计事件
  - 模型配置
endlegend

@enduml
